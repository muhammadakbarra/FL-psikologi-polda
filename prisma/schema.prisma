// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  password         String
  masterKesatuanId Int // Menyimpan informasi kesatuan
  nama_kota        String? // Menyimpan nama kota (opsional)
  id_biodata       Int? // Masih bisa digunakan untuk relasi biodata (jika diperlukan)
  biodata          Biodata?          @relation(fields: [id_biodata], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  UserTestSession  UserTestSession[]

  // Relasi ke MasterKesatuan
  masterKesatuan MasterKesatuan @relation(fields: [masterKesatuanId], references: [id])
}

model Admin {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  role      Role       @default(ADMIN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  HasilTes  HasilTes[]
}

enum Role {
  ADMIN
  SUPERADMIN
}

model MasterJenisTes {
  id             Int      @id @default(autoincrement())
  nama_jenis_tes String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi satu ke banyak ke KategoriTes
  kategoriTes KategoriTes[]
}

model KategoriTes {
  id                Int      @id @default(autoincrement())
  nama_kategori_tes String
  masterJenisTesId  Int
  waktu_pengerjaan  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  masterJenisTes MasterJenisTes @relation(fields: [masterJenisTesId], references: [id])

  // Relasi balik ke Soal dan UserTestSession
  soal            Soal[]
  UserTestSession UserTestSession[]
}

model MasterKesatuan {
  id            Int      @id @default(autoincrement())
  nama_kesatuan String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relasi balik ke User karena informasi kesatuan disimpan di User
  users User[]
}

model MasterPangkat {
  id           Int      @id @default(autoincrement())
  nama_pangkat String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relasi balik ke Biodata
  biodata Biodata[]
}

model Biodata {
  id              Int      @id @default(autoincrement())
  nama_lengkap    String
  nrp             String
  jabatan         String
  masterPangkatId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  masterPangkat MasterPangkat @relation(fields: [masterPangkatId], references: [id])
  // Relasi ke User tetap disimpan sebagai back-relation (opsional)
  User          User[]
}

model Soal {
  id            Int      @id @default(autoincrement())
  kategoriTesId Int
  teks_soal     String?  @db.Text
  gambar_soal   String? // Nullable untuk soal tanpa gambar
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relasi ke KategoriTes
  kategoriTes KategoriTes @relation(fields: [kategoriTesId], references: [id])

  // Relasi one-to-many ke PilihanJawaban dan UserAnswer
  pilihanJawaban PilihanJawaban[]
  UserAnswer     UserAnswer[]
}

model PilihanJawaban {
  id             Int      @id @default(autoincrement())
  soalId         Int
  teks_pilihan   String?  @db.Text
  gambar_pilihan String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi ke Soal
  soal       Soal         @relation(fields: [soalId], references: [id])
  UserAnswer UserAnswer[]
}

model UserTestSession {
  id             Int       @id @default(autoincrement())
  userId         Int
  kategoriTesId  Int
  noTes          String? // Boleh null
  jenisPengajuan String? // Boleh null
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  kategoriTes KategoriTes  @relation(fields: [kategoriTesId], references: [id])
  userAnswers UserAnswer[]
  HasilTes    HasilTes[]
}

model UserAnswer {
  id                Int      @id @default(autoincrement())
  userTestSessionId Int
  soalId            Int
  pilihanJawabanId  Int? // Boleh null jika essay
  teks_jawaban      String? // Boleh null jika pilihan ganda
  answeredAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userTestSession UserTestSession @relation(fields: [userTestSessionId], references: [id])
  soal            Soal            @relation(fields: [soalId], references: [id])
  pilihanJawaban  PilihanJawaban? @relation(fields: [pilihanJawabanId], references: [id])
}

enum HasilTesStatus {
  MENUNGGU
  MEMENUHI_SYARAT
  TIDAK_MEMENUHI_SYARAT
}

model HasilTes {
  id                Int            @id @default(autoincrement())
  userTestSessionId Int
  status            HasilTesStatus @default(MENUNGGU)
  keterangan        String? // Opsional, admin dapat mengisi keterangan
  adminId           Int? // Opsional, menyimpan id admin yang memverifikasi
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  userTestSession UserTestSession @relation(fields: [userTestSessionId], references: [id])
  admin           Admin?          @relation(fields: [adminId], references: [id])
}
