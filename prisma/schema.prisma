// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  id_biodata Int? // Foreign key (future)
  // Tambahkan relasi ini agar Prisma bisa include biodata langsung
  biodata    Biodata? @relation(fields: [id_biodata], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPERADMIN
}

model MasterJenisTes {
  id             Int      @id @default(autoincrement())
  nama_jenis_tes String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi satu ke banyak ke KategoriTes
  kategoriTes KategoriTes[]
}

model KategoriTes {
  id                Int      @id @default(autoincrement())
  nama_kategori_tes String
  masterJenisTesId  Int
  waktu_pengerjaan  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  masterJenisTes MasterJenisTes @relation(fields: [masterJenisTesId], references: [id])

  // Relasi balik ke Soal
  soal Soal[]
}

model MasterKesatuan {
  id            Int      @id @default(autoincrement())
  nama_kesatuan String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Tambahkan relasi balik ke Biodata
  biodata Biodata[]
}

model MasterPangkat {
  id           Int      @id @default(autoincrement())
  nama_pangkat String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Tambahkan relasi balik ke Biodata
  biodata Biodata[]
}

model Biodata {
  id               Int      @id @default(autoincrement())
  nama_lengkap     String
  nrp              String
  jabatan          String
  masterKesatuanId Int
  masterPangkatId  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  masterKesatuan MasterKesatuan @relation(fields: [masterKesatuanId], references: [id])
  masterPangkat  MasterPangkat  @relation(fields: [masterPangkatId], references: [id])
  User           User[]
}

model Soal {
  id            Int      @id @default(autoincrement())
  kategoriTesId Int
  teks_soal     String?  @db.Text
  gambar_soal   String? // Nullable untuk soal tanpa gambar
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relasi ke kategori tes
  kategoriTes KategoriTes @relation(fields: [kategoriTesId], references: [id])

  // Relasi one-to-many ke pilihan jawaban
  pilihanJawaban PilihanJawaban[]
}

model PilihanJawaban {
  id             Int      @id @default(autoincrement())
  soalId         Int
  teks_pilihan   String?  @db.Text
  gambar_pilihan String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi ke soal
  soal Soal @relation(fields: [soalId], references: [id])
}
