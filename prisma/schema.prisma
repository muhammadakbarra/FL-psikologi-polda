// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  password         String
  masterKesatuanId Int
  nama_kota        String?
  id_biodata       Int?
  biodata          Biodata?          @relation(fields: [id_biodata], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  UserTestSession  UserTestSession[]

  masterKesatuan MasterKesatuan @relation(fields: [masterKesatuanId], references: [id])
}

model Admin {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  role      Role       @default(ADMIN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  HasilTes  HasilTes[]
}

enum Role {
  ADMIN
  SUPERADMIN
}

model MasterJenisTes {
  id             Int      @id @default(autoincrement())
  nama_jenis_tes String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi satu ke banyak ke KategoriTes
  kategoriTes KategoriTes[]
}

model KategoriTes {
  id                Int      @id @default(autoincrement())
  nama_kategori_tes String
  masterJenisTesId  Int
  waktu_pengerjaan  String
  instruksi_tes     String?  @db.Text  // Tambahkan field ini dengan tipe Text dan opsional (nullable)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  masterJenisTes MasterJenisTes @relation(fields: [masterJenisTesId], references: [id])

  soal            Soal[]
  UserTestSession UserTestSession[]
}

model MasterKesatuan {
  id            Int      @id @default(autoincrement())
  nama_kesatuan String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  users User[]
}

model MasterPangkat {
  id           Int      @id @default(autoincrement())
  nama_pangkat String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  biodata Biodata[]
}

model Biodata {
  id              Int      @id @default(autoincrement())
  nama_lengkap    String
  nrp             String
  jabatan         String
  masterPangkatId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  masterPangkat MasterPangkat @relation(fields: [masterPangkatId], references: [id])
  User          User[]
}

model Soal {
  id            Int      @id @default(autoincrement())
  kategoriTesId Int
  teks_soal     String?  @db.Text
  gambar_soal   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  // Relasi ke KategoriTes (onDelete: Cascade)
  kategoriTes KategoriTes @relation(fields: [kategoriTesId], references: [id], onDelete: Cascade)

  // Relasi one-to-many ke PilihanJawaban dan UserAnswer
  pilihanJawaban PilihanJawaban[]
  UserAnswer     UserAnswer[]
}

model PilihanJawaban {
  id             Int      @id @default(autoincrement())
  soalId         Int
  teks_pilihan   String?  @db.Text
  gambar_pilihan String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  // Relasi ke Soal (onDelete: Cascade)
  soal Soal @relation(fields: [soalId], references: [id], onDelete: Cascade)

  // Relasi ke UserAnswer
  UserAnswer UserAnswer[]
}

model UserTestSession {
  id             Int       @id @default(autoincrement())
  userId         Int
  kategoriTesId  Int
  noTes          String?
  jenisPengajuan String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id])
  // Tambahkan onDelete: Cascade di sini
  kategoriTes KategoriTes  @relation(fields: [kategoriTesId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]
  HasilTes    HasilTes[]
}

model UserAnswer {
  id                Int      @id @default(autoincrement())
  userTestSessionId Int
  soalId            Int
  pilihanJawabanId  Int?
  teks_jawaban      String?
  answeredAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  userTestSession UserTestSession @relation(fields: [userTestSessionId], references: [id])
  soal            Soal            @relation(fields: [soalId], references: [id], onDelete: Cascade)
  pilihanJawaban  PilihanJawaban? @relation(fields: [pilihanJawabanId], references: [id], onDelete: Cascade)
}

enum HasilTesStatus {
  MENUNGGU
  MEMENUHI_SYARAT
  TIDAK_MEMENUHI_SYARAT
}

model HasilTes {
  id                Int            @id @default(autoincrement())
  userTestSessionId Int
  status            HasilTesStatus @default(MENUNGGU)
  keterangan        String?
  adminId           Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now())

  userTestSession UserTestSession @relation(fields: [userTestSessionId], references: [id])
  admin           Admin?          @relation(fields: [adminId], references: [id])
}


model WebsiteBackground {
  id          Int      @id @default(autoincrement())
  svg_path    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
