generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id        Int        @id @default(autoincrement())
  username  String     @unique(map: "Admin_username_key")
  password  String
  role      admin_role @default(ADMIN)
  createdAt DateTime   @default(now())
  updatedAt DateTime
  hasiltes  hasiltes[]
}

model biodata {
  id              Int           @id @default(autoincrement())
  nama_lengkap    String
  nrp             String
  jabatan         String
  masterPangkatId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  masterpangkat   masterpangkat @relation(fields: [masterPangkatId], references: [id], onDelete: NoAction, map: "Biodata_masterPangkatId_fkey")
  user            user[]

  @@index([masterPangkatId], map: "Biodata_masterPangkatId_fkey")
}

model hasiltes {
  id                Int             @id @default(autoincrement())
  userTestSessionId Int
  status            hasiltes_status @default(MENUNGGU)
  keterangan        String?
  adminId           Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  masa_berlaku      String?
  admin             admin?          @relation(fields: [adminId], references: [id], map: "HasilTes_adminId_fkey")
  usertestsession   usertestsession @relation(fields: [userTestSessionId], references: [id], onDelete: Cascade, map: "HasilTes_userTestSessionId_fkey")

  @@index([adminId], map: "HasilTes_adminId_fkey")
  @@index([userTestSessionId], map: "HasilTes_userTestSessionId_fkey")
}

model kategorites {
  id                Int               @id @default(autoincrement())
  nama_kategori_tes String
  masterJenisTesId  Int
  waktu_pengerjaan  String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now())
  instruksi_tes     String?           @db.Text
  masterjenistes    masterjenistes    @relation(fields: [masterJenisTesId], references: [id], onDelete: NoAction, map: "KategoriTes_masterJenisTesId_fkey")
  soal              soal[]
  usertestsession   usertestsession[]

  @@index([masterJenisTesId], map: "KategoriTes_masterJenisTesId_fkey")
}

model masterjenistes {
  id             Int           @id @default(autoincrement())
  nama_jenis_tes String        @unique(map: "MasterJenisTes_nama_jenis_tes_key")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  kategorites    kategorites[]
}

model masterkesatuan {
  id            Int      @id @default(autoincrement())
  nama_kesatuan String   @unique(map: "MasterKesatuan_nama_kesatuan_key")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  user          user[]
}

model masterpangkat {
  id           Int       @id @default(autoincrement())
  nama_pangkat String    @unique(map: "MasterPangkat_nama_pangkat_key")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  biodata      biodata[]
}

model pilihanjawaban {
  id             Int          @id @default(autoincrement())
  soalId         Int
  teks_pilihan   String?      @db.Text
  gambar_pilihan String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  soal           soal         @relation(fields: [soalId], references: [id], onDelete: Cascade, map: "PilihanJawaban_soalId_fkey")
  useranswer     useranswer[]

  @@index([soalId], map: "PilihanJawaban_soalId_fkey")
}

model soal {
  id             Int              @id @default(autoincrement())
  kategoriTesId  Int
  teks_soal      String?          @db.Text
  gambar_soal    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
  pilihanjawaban pilihanjawaban[]
  kategorites    kategorites      @relation(fields: [kategoriTesId], references: [id], onDelete: Cascade, map: "Soal_kategoriTesId_fkey")
  useranswer     useranswer[]

  @@index([kategoriTesId], map: "Soal_kategoriTesId_fkey")
}

model user {
  id               Int               @id @default(autoincrement())
  username         String            @unique(map: "User_username_key")
  password         String
  id_biodata       Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  masterKesatuanId Int
  nama_kota        String?
  biodata          biodata?          @relation(fields: [id_biodata], references: [id], map: "User_id_biodata_fkey")
  masterkesatuan   masterkesatuan    @relation(fields: [masterKesatuanId], references: [id], onDelete: NoAction, map: "User_masterKesatuanId_fkey")
  usertestsession  usertestsession[]

  @@index([id_biodata], map: "User_id_biodata_fkey")
  @@index([masterKesatuanId], map: "User_masterKesatuanId_fkey")
}

model useranswer {
  id                Int             @id @default(autoincrement())
  userTestSessionId Int
  soalId            Int
  pilihanJawabanId  Int?
  teks_jawaban      String?
  answeredAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  pilihanjawaban    pilihanjawaban? @relation(fields: [pilihanJawabanId], references: [id], onDelete: Cascade, map: "UserAnswer_pilihanJawabanId_fkey")
  soal              soal            @relation(fields: [soalId], references: [id], onDelete: Cascade, map: "UserAnswer_soalId_fkey")
  usertestsession   usertestsession @relation(fields: [userTestSessionId], references: [id], onDelete: Cascade, map: "UserAnswer_userTestSessionId_fkey")

  @@index([pilihanJawabanId], map: "UserAnswer_pilihanJawabanId_fkey")
  @@index([soalId], map: "UserAnswer_soalId_fkey")
  @@index([userTestSessionId], map: "UserAnswer_userTestSessionId_fkey")
}

model usertestsession {
  id             Int          @id @default(autoincrement())
  userId         Int
  kategoriTesId  Int
  noTes          String?
  jenisPengajuan String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  hasiltes       hasiltes[]
  useranswer     useranswer[]
  kategorites    kategorites  @relation(fields: [kategoriTesId], references: [id], onDelete: Cascade, map: "UserTestSession_kategoriTesId_fkey")
  user           user         @relation(fields: [userId], references: [id], onDelete: NoAction, map: "UserTestSession_userId_fkey")

  @@index([kategoriTesId], map: "UserTestSession_kategoriTesId_fkey")
  @@index([userId], map: "UserTestSession_userId_fkey")
}

model websitebackground {
  id        Int      @id @default(autoincrement())
  svg_path  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

enum hasiltes_status {
  MENUNGGU
  MEMENUHI_SYARAT
  TIDAK_MEMENUHI_SYARAT
}

enum admin_role {
  ADMIN
  SUPERADMIN
}
