// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  id_biodata Int? // Foreign key (future)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPERADMIN
}

model MasterJenisTes {
  id             Int           @id @default(autoincrement())
  nama_jenis_tes String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  kategoriTes    KategoriTes[] // Relasi satu ke banyak ke KategoriTes
}

model KategoriTes {
  id                Int      @id @default(autoincrement())
  nama_kategori_tes String
  masterJenisTesId  Int
  waktu_pengerjaan  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  masterJenisTes MasterJenisTes @relation(fields: [masterJenisTesId], references: [id])
}

model MasterKesatuan {
  id            Int      @id @default(autoincrement())
  nama_kesatuan String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MasterPangkat {
  id           Int      @id @default(autoincrement())
  nama_pangkat String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
